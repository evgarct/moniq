# Shared secret the Moniq cron sends as "Authorization: Bearer <token>". Generate a long random value.
FORECAST_API_TOKEN=
# Hugging Face model id. chronos-bolt-small is the default; see README before switching families.
FORECAST_MODEL=amazon/chronos-bolt-small
# torch CPU threads; keep low so the box stays responsive for other services.
FORECAST_THREADS=1
# Public hostname Caddy serves (used by the Caddyfile snippet in the README).
FORECAST_DOMAIN=forecast.safronov.dev
